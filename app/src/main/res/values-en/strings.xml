    <string name="methodology_title">How do we calculate this?</string>
    <string name="methodology_intro">An estimate based on the SAF booking history. All calculations take place locally on your device.</string>
    <string name="methodology_sources_title">Data sources</string>
    <string name="methodology_sources_body">SAF data workbook: “Spaces”, “General timetable” and “Bookings” sheets. The data is pre-processed and the app receives only aggregated counts by activity, day and time slot.</string>
    <string name="methodology_period_title">Reference period</string>
    <string name="methodology_period_body">By default, the app uses April, May, June, September and October 2026 (teaching period). You can also consult the full period from April to October.</string>
    <string name="methodology_occupancy_title">How occupancy is calculated</string>
    <string name="methodology_occupancy_body">Gyms and swimming pools: average number of people with a booking overlapping the time slot, divided by capacity. Courts and pitches: average number of booked units divided by the number of available units. Long bookings count as occupied and may be marked as club or school sessions.</string>
    <string name="methodology_labels_title">Occupancy labels</string>
    <string name="methodology_labels_body" formatted="false">Quiet: below 50%. Moderate: from 50% to below 80%. Busy: 80% or more. An alternative is suggested only when it is at least 10 percentage points quieter than the selected time slot.</string>
    <string name="methodology_limitations_title">Data limitations</string>
    <string name="methodology_limit_1">Shows usual occupancy (historical average), not real-time occupancy.</string>
    <string name="methodology_limit_2">Counts bookings, not the people who actually attended.</string>
    <string name="methodology_limit_3">Default period: April–June and September–October 2026; activity is much lower in July and August.</string>
    <string name="methodology_limit_4">Courts are counted as occupied or available units; gyms and swimming pools are counted in people.</string>
    <string name="methodology_limit_5">The data contains no personal identifiers: the app does not know who you are and does not personalize results.</string>
    <string name="methodology_limit_6">Time slots with fewer than 8 observed days are marked as “limited data”.</string>
    <string name="methodology_limit_7">Fitness room shift changes (10:00 and 15:00) do not have data.</string>
    <string name="methodology_privacy">Privacy: this app does not need an internet connection, contains no analytics and does not send data outside your device.</string>


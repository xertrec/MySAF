# Copy to backend/.env and fill in UTH_KEY. Never commit .env.
LLM_PROVIDER=openai
LLM_MODEL=ornith
LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
UTH_KEY=your_existing_team_key

# Optional tuning (defaults shown)
# LLM_TIMEOUT_S=60
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_PARALLEL_TOOL_CALLS=true
# LLM_TEXT_TOOL_CALL_FALLBACK=true
# MAX_TOOL_ROUNDS=3
# TURN_TTL_S=300
# CONVERSATION_TTL_S=3600
# GROUNDING_MODE=strict
# LOG_LEVEL=INFO

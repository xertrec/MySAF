              "hour": {
                "maximum": 23,
                "minimum": 0,
                "title": "Hour",
                "type": "integer"
              },
              "occupied": {
                "minimum": 0,
                "title": "Occupied",
                "type": "integer"
              },
              "capacity": {
                "minimum": 0,
                "title": "Capacity",
                "type": "integer"
              },
              "load": {
                "maximum": 10,
                "minimum": 0,
                "title": "Load",
                "type": "number"
              },
              "is_closed": {
                "default": false,
                "title": "Is Closed",
                "type": "boolean"
              },
              "shift_change": {
                "default": false,
                "title": "Shift Change",
                "type": "boolean"
              },
              "low_data": {
                "default": false,
                "title": "Low Data",
                "type": "boolean"
              },
              "long_block": {
                "default": false,
                "title": "Long Block",
                "type": "boolean"
              },
              "usable": {
                "title": "Usable",

              "activity_id": {
                "title": "Activity Id",
                "type": "string"
              },
              "weekday": {
                "enum": [
                  "dl",
                  "dt",
                  "dc",
                  "dj",
                  "dv",
                  "ds",
                  "dg"
                ],
                "title": "Weekday",
                "type": "string"
              },
              "reduction_pp": {
                "title": "Reduction Pp",
                "type": "integer"
              },
              "row": {
                "$ref": "#/$defs/HourRow"
              }
            },
            "required": [
              "kind",
              "activity_id",
              "weekday",
              "reduction_pp",
              "row"
            ],
            "title": "AlternativeOut",
            "type": "object"
          },
          "HourRow": {
            "description": "Serialised ``HourAvailability`` plus Kotlin's ``occupancyLabel`` and ``isUsable``.",

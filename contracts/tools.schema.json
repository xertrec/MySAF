        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "properties": {
          "entries": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Entries",
            "type": "object"
          }
        },
        "required": [
          "entries"
        ],
        "title": "DatasetInfoResult",
        "type": "object"
      }
    }
  ]
